# Copia este archivo como .env.local y reinicia Vite despues de cambiarlo.
#
# Vacio  -> usa los datos de ejemplo locales, sin backend.
# Con URL -> habla con el agente real por HTTP.
#
# Corriendo el backend en local (cd backend && uvicorn agent:app --port 8000):
# VITE_A2UI_ENDPOINT=http://localhost:8000/chat
VITE_A2UI_ENDPOINT=

# Milisegundos que espera una consulta antes de cancelarse. Opcional -- si
# se deja vacío o no es un número válido, se usa el default (15000).
# VITE_A2UI_TIMEOUT_MS=15000
VITE_A2UI_TIMEOUT_MS=
